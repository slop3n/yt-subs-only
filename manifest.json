{
  "manifest_version": 3,
  "name": "YouTube Subscriptions Only",
  "version": "1.0.3",
  "description": "No Shorts, no \"Most relevant\" shelf: your YouTube subscriptions feed as new uploads only, newest first, 5 per row. Collects no data.",
  "homepage_url": "https://github.com/slop3n/yt-subs-only",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "YouTube Subscriptions Only"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "hide.css"
      ],
      "js": [
        "hide.js"
      ],
      "run_at": "document_start"
    }
  ]
}
